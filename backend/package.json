{
  "name": "eventhub-backend",
  "version": "1.0.0",
  "private": true,
  "description": "EventHub API - Node.js + Express + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node db/migrate.js",
